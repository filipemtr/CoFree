# Copy this file to .env and REPLACE the placeholder secrets with random values.
ENVIRONMENT=development
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
APP_SECRET=CHANGE_ME_WITH_A_UNIQUE_RANDOM_VALUE_OF_AT_LEAST_32_CHARS
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
# XposedOrNot free API: no API Key required. Shared Redis quota protects 2/s, 25/h, 100/day per IP.
# Public XON API use is intended for personal/academic low-volume usage.
# Local development emails are delivered to Mailpit at http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SENDER=CoFree <no-reply@cofree.local>
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
# Frequência definida separadamente no painel Configurações > Monitoramento automático.
