# CoFree — .gitignore (colocar na raiz do repositório)
# ATENÇÃO: .gitignore não remove arquivos já versionados.

# Variáveis de ambiente / segredos locais
.env
.env.*
!.env.example
!.env.*.example
*.env.local
*.local.env

# Segredos / chaves privadas / certificados com chave
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.asc
*.gpg
secrets/
.private/

# Dumps e backups de dados (script infrastructure/scripts/backup.sh)
backups/
backup/
*.dump
*.sql.gz
*.sql.bz2
*.sql.xz
*.backup
*.bak
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite3-journal
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal

# Python / testes / cobertura
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
ENV/
.python-version

# Node / Vite / Playwright
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.next/
.nuxt/
.svelte-kit/
.vite/
*.tsbuildinfo
playwright-report/
playwright/.cache/
test-results/
.nyc_output/
*.lcov

# Celery e Redis persistidos localmente
celerybeat-schedule*
celerybeat.pid
celeryd.pid
*.rdb
appendonly.aof
appendonlydir/

# Terraform (caso infraestrutura seja adicionada)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
crash.*.log

# Logs, temporários e arquivos de ferramentas
*.log
logs/
tmp/
temp/
*.tmp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# Relatórios de auditoria e dados de captura locais
.zap/
zap-reports/
trivy-cache/
.cache/
